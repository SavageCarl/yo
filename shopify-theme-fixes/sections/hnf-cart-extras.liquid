{%- comment -%}
  Cart conversion helpers (funnel roadmap, step 1):
  - states the real shipping cost up front, so the $5.99 is not a surprise at checkout
  - single-item carts get an "add 1 more, save 15%" nudge (the "Bundle & Save: 15% off 2+ items"
    automatic discount is live), with two quick-add suggestions
  Placed in templates/cart.json between cart-items and cart-footer.

  "Bundle & Save" only covers the products listed on that discount. These product ids
  are NOT on it (Walking Pad, Indoor Cycling Bike, Everyday Set bundle, Yoga Foam
  Roller, free gift), so they don't count toward the 2 items and are never suggested.
  Keep this list in step with the discount (same ids as snippets/hnf-bundle-picker.liquid).
{%- endcomment -%}
{%- assign hnf_not_bundle_ids = '8107948834891,8109643825227,8110436974667,8107907317835,9588018315339' | split: ',' -%}
<div id="hnf-cart-extras" data-id="{{ section.id }}">
{%- if cart != empty -%}
  {%- liquid
    assign hnf_paid_total = 0
    assign hnf_bundle_qty = 0
    for item in cart.items
      if item.variant.id == 48947160383563 or item.properties._hnf_gift
        continue
      endif
      assign hnf_paid_total = hnf_paid_total | plus: item.final_line_price
      assign hnf_pid = item.product_id | append: ''
      unless hnf_not_bundle_ids contains hnf_pid
        assign hnf_bundle_qty = hnf_bundle_qty | plus: item.quantity
      endunless
    endfor
  -%}
  <style>
    .hnf-cx { max-width: var(--page-width, 120rem); margin: 0 auto; padding: 0 1.5rem; }
    @media screen and (min-width: 750px) { .hnf-cx { padding: 0 5rem; } }
    .hnf-cx__row { display: flex; flex-wrap: wrap; gap: 1.2rem; justify-content: flex-end; }
    .hnf-cx__box { flex: 1 1 32rem; max-width: 48rem; border-radius: 8px; padding: 1.3rem 1.5rem; font-size: 1.35rem; line-height: 1.5; }
    .hnf-cx__ship { background: rgba(var(--color-foreground), .04); }
    .hnf-cx__nudge { border: 1px dashed rgb(var(--color-button)); }
    .hnf-cx__nudge strong, .hnf-cx__ship strong { font-weight: 700; }
    .hnf-cx__picks { display: grid; grid-template-columns: 1fr 1fr; gap: .8rem; margin-top: 1rem; }
    .hnf-cx__pick { display: flex; gap: .8rem; align-items: center; border: 1px solid rgba(var(--color-foreground), .12); border-radius: 6px; padding: .6rem; background: rgb(var(--color-background)); }
    .hnf-cx__pick img { width: 4.8rem; height: 4.8rem; object-fit: cover; border-radius: 4px; flex: none; }
    .hnf-cx__pick span { display: block; font-size: 1.2rem; line-height: 1.3; }
    .hnf-cx__pick button { margin-top: .3rem; font: 700 1.15rem/1 var(--font-body-family); background: rgb(var(--color-button)); color: rgb(var(--color-button-text)); border: 0; border-radius: 4px; padding: .5rem .8rem; cursor: pointer; }
  </style>
  <div class="hnf-cx">
    <div class="hnf-cx__row">
      {%- if hnf_bundle_qty == 1 -%}
        <div class="hnf-cx__box hnf-cx__nudge">
          <strong>Add 1 more item and save 15% on both.</strong>
          Mix and match across the store (the Walking Pad, Indoor Cycling Bike and Everyday Set are already priced separately). The discount applies automatically, right here in your cart.
          {%- assign hnf_in_cart = cart.items | map: 'product_id' -%}
          {%- assign hnf_shown = 0 -%}
          <div class="hnf-cx__picks">
            {%- for p in collections.all.products -%}
              {%- if hnf_shown >= 2 -%}{%- break -%}{%- endif -%}
              {%- assign hnf_p_id = p.id | append: '' -%}
              {%- if hnf_in_cart contains p.id or p.available == false or hnf_not_bundle_ids contains hnf_p_id or p.tags contains 'hidden' or p.price < 1500 or p.price > 6000 -%}{%- continue -%}{%- endif -%}
              {%- assign hnf_shown = hnf_shown | plus: 1 -%}
              <div class="hnf-cx__pick">
                {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 120 }}" alt="{{ p.title | escape }}" loading="lazy" width="48" height="48">{%- endif -%}
                <div>
                  <span>{{ p.title }}</span>
                  <span><s>{{ p.price | money }}</s> {{ p.price | times: 85 | divided_by: 100 | money }}</span>
                  <button type="button" data-hnf-cx-add="{{ p.selected_or_first_available_variant.id }}">Add &amp; save 15%</button>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
      {%- if hnf_paid_total < 10000 -%}
        <div class="hnf-cx__box hnf-cx__ship">
          Standard US shipping on this order: <strong>$5.99</strong>.
          Orders over <strong>$100</strong> ship free and include a free Yoga Foam Roller.
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
</div>
  <script>
    document.addEventListener('click', function (e) {
      var b = e.target.closest('[data-hnf-cx-add]');
      if (!b) return;
      b.disabled = true; b.textContent = 'Adding…';
      fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ items: [{ id: Number(b.getAttribute('data-hnf-cx-add')), quantity: 1 }] }) })
        .then(function () { setTimeout(function () { location.reload(); }, 600); }, function () { location.reload(); });
    });

    /* Dawn's cart.js only re-renders the line items and the totals block after a
       quantity change, so this section and the free-shipping bar in the cart footer
       went stale (e.g. "add 1 more" still showing with 2 items). Re-render both. */
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof subscribe !== 'function' || typeof PUB_SUB_EVENTS === 'undefined') return;
      subscribe(PUB_SUB_EVENTS.cartUpdate, function () {
        var extras = document.getElementById('hnf-cart-extras');
        var footer = document.getElementById('main-cart-footer');
        var ids = [extras && extras.dataset.id, footer && footer.dataset.id].filter(Boolean);
        if (!ids.length) return;
        return fetch(window.location.pathname + '?sections=' + ids.join(','))
          .then(function (r) { return r.json(); })
          .then(function (sections) {
            function parse(id) { return sections[id] ? new DOMParser().parseFromString(sections[id], 'text/html') : null; }
            var ex = extras && parse(extras.dataset.id);
            var exNew = ex && ex.getElementById('hnf-cart-extras');
            if (exNew) extras.innerHTML = exNew.innerHTML;
            var ft = footer && parse(footer.dataset.id);
            var barOld = footer && footer.querySelector('.hnf-cart-shipping-bar');
            var barNew = ft && ft.querySelector('.hnf-cart-shipping-bar');
            if (barOld && barNew) barOld.innerHTML = barNew.innerHTML;
          })
          .catch(function () {});
      });
    });
  </script>

{% schema %}
{
  "name": "HNF cart extras",
  "settings": []
}
{% endschema %}
