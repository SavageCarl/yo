{%- style -%}
  .hnf-lp {
    --ink: #0b0b0b; --ink-2: #151515; --paper: #ffffff; --paper-dim: #f5f5f3;
    --warm-bg: #f8f4ee; --warm-bg-2: #f2ece2; --soft-gray: #eaeae7;
    --text: #111111; --muted: #666666; --accent: #ff5a1f; --accent-hover: #ff7440;
    background: var(--paper); color: var(--text);
  }
  .hnf-lp * { box-sizing: border-box; }
  .hnf-lp__section { padding: clamp(5rem, 8vw, 8rem) 0; }
  .hnf-lp__section--warm { background: linear-gradient(180deg, var(--warm-bg) 0%, var(--warm-bg-2) 100%); }
  .hnf-lp__section--gray { background: var(--paper-dim); }
  .hnf-lp__section--black { background: var(--ink); color: #fff; }
  .hnf-lp__inner { max-width: 84rem; margin: 0 auto; padding: 0 2rem; }
  .hnf-lp__inner--wide { max-width: 110rem; }
  @media screen and (max-width: 749px) { .hnf-lp__section { padding: clamp(3.5rem, 12vw, 5rem) 0; } }

  .hnf-lp__eyebrow {
    display: block; font-family: var(--font-body-family); font-weight: 600; font-size: 1.2rem;
    letter-spacing: 0.16em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.9rem; text-align: center;
  }
  .hnf-lp__h2 {
    font-family: var(--font-heading-family); font-weight: 400; text-transform: uppercase;
    font-size: clamp(2.8rem, 4.4vw, 4rem); line-height: 1.04; letter-spacing: 0.005em;
    margin: 0 0 1.4rem; text-align: center; color: var(--text);
  }
  .hnf-lp__section--black .hnf-lp__h2 { color: #fff; }
  .hnf-lp__lede {
    font-family: var(--font-body-family); font-size: 1.6rem; line-height: 1.6; color: var(--muted);
    max-width: 60ch; margin: 0 auto; text-align: center;
  }
  .hnf-lp__section--black .hnf-lp__lede { color: #c9c9c9; }

  .hnf-lp__btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.7rem;
    min-height: 5.4rem; padding: 0 3rem; font-family: var(--font-body-family); font-weight: 700;
    font-size: 1.35rem; letter-spacing: 0.06em; text-transform: uppercase; text-decoration: none;
    border-radius: 2px; background: var(--accent); color: #fff; border: 2px solid var(--accent);
    box-shadow: 0 16px 32px -16px rgba(255,90,31,0.5);
    transition: background-color .12s ease, border-color .12s ease, transform .12s ease;
  }
  .hnf-lp__btn:hover { background: var(--accent-hover); border-color: var(--accent-hover); transform: translateY(-1px); }
  .hnf-lp__btn--outline { background: transparent; color: #fff; border-color: rgba(255,255,255,0.5); box-shadow: none; }
  .hnf-lp__btn--outline:hover { background: #fff; color: var(--ink); }

  /* HERO */
  .hnf-lp__hero { position: relative; background: var(--ink); overflow: hidden; }
  .hnf-lp__hero-media { position: absolute; inset: 0; }
  .hnf-lp__hero-media img { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; display: block; opacity: 0.55; }
  .hnf-lp__hero-scrim { position: absolute; inset: 0; background: linear-gradient(90deg, rgba(11,11,11,0.92) 0%, rgba(11,11,11,0.55) 55%, rgba(11,11,11,0.25) 100%); }
  .hnf-lp__hero-inner { position: relative; z-index: 1; padding: clamp(7rem, 14vw, 12rem) 2rem; max-width: 110rem; margin: 0 auto; }
  .hnf-lp__hero-eyebrow { font-family: var(--font-body-family); font-weight: 600; font-size: 1.3rem; letter-spacing: 0.18em; text-transform: uppercase; color: #a3a3a3; margin: 0 0 1.4rem; }
  .hnf-lp__hero h1 { font-family: var(--font-heading-family); font-weight: 400; text-transform: uppercase; color: #fff; font-size: clamp(3.4rem, 6.5vw, 6.4rem); line-height: 0.96; letter-spacing: 0.005em; margin: 0 0 2rem; max-width: 18ch; }
  .hnf-lp__hero p { font-family: var(--font-body-family); font-size: 1.7rem; line-height: 1.55; color: #d8d8d8; max-width: 46ch; margin: 0 0 3rem; }
  .hnf-lp__hero-ctas { display: flex; flex-wrap: wrap; gap: 1.4rem; }

  /* TRUSTED BY — made much bigger/bolder than the rest of the small eyebrow text */
  .hnf-lp__section--warm .hnf-lp__eyebrow { font-size: 1.7rem; letter-spacing: 0.14em; margin-bottom: 2rem; }
  .hnf-lp__trustbar { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 2.8rem 5.2rem; margin-top: 1.4rem; }
  .hnf-lp__trust-item { display: flex; align-items: center; gap: 1.2rem; font-family: var(--font-body-family); font-weight: 700; font-size: 1.9rem; letter-spacing: 0.01em; color: var(--text); }
  .hnf-lp__trust-item svg { width: 3.4rem; height: 3.4rem; color: var(--accent); flex: none; }
  @media screen and (max-width: 749px) {
    .hnf-lp__trust-item { font-size: 1.5rem; gap: 0.9rem; }
    .hnf-lp__trust-item svg { width: 2.6rem; height: 2.6rem; }
    .hnf-lp__trustbar { gap: 2rem 3rem; }
  }

  /* PROBLEM */
  .hnf-lp__problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.6rem; margin-top: 3.6rem; }
  .hnf-lp__problem-card { text-align: left; border-top: 2px solid var(--accent); padding-top: 1.8rem; }
  .hnf-lp__problem-card h3 { font-family: var(--font-body-family); font-weight: 700; font-size: 1.5rem; margin: 0 0 0.8rem; color: var(--text); }
  .hnf-lp__problem-card p { font-family: var(--font-body-family); font-size: 1.3rem; line-height: 1.55; color: var(--muted); margin: 0; }
  @media screen and (max-width: 749px) { .hnf-lp__problem-grid { grid-template-columns: 1fr; } }

  /* THE SET intro — pure-CSS Ken Burns zoom/pan on the STATIC image. No AI
     video regeneration involved, so the baked-in text stays pixel-perfect. */
  .hnf-lp__set-media { max-width: 74rem; margin: 3.6rem auto 0; box-shadow: 0 30px 70px -32px rgba(11,11,11,0.4); border: 1px solid rgba(11,11,11,0.06); overflow: hidden; }
  .hnf-lp__set-media img { width: 100%; height: auto; display: block; }
  @keyframes hnf-lp-kenburns {
    0% { transform: scale(1) translate(0, 0); }
    100% { transform: scale(1.07) translate(-1.2%, -1%); }
  }
  .hnf-lp__set-media-kb {
    animation: hnf-lp-kenburns 17s ease-in-out infinite alternate;
    transform-origin: center center;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .hnf-lp__set-media-kb { animation: none; }
  }

  /* WHAT YOU GET */
  .hnf-lp__items { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem; margin-top: 3.6rem; }
  .hnf-lp__item-card { background: var(--paper); border: 1px solid var(--soft-gray); padding: 2.2rem; display: flex; flex-direction: column; gap: 1.4rem; }
  .hnf-lp__item-card--free { border-color: var(--accent); }
  .hnf-lp__item-media { aspect-ratio: 1/1; background: var(--paper-dim); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .hnf-lp__item-media img { width: 78%; height: 78%; object-fit: contain; }
  .hnf-lp__item-tag { display: inline-block; align-self: flex-start; font-family: var(--font-body-family); font-weight: 700; font-size: 1.05rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.4rem 0.9rem; background: var(--paper-dim); color: var(--muted); }
  .hnf-lp__item-card--free .hnf-lp__item-tag { background: var(--accent); color: #fff; }
  .hnf-lp__item-name { font-family: var(--font-heading-family); font-weight: 400; text-transform: uppercase; font-size: 2.1rem; line-height: 1.05; margin: 0; color: var(--text); }
  .hnf-lp__item-purpose { font-family: var(--font-body-family); font-weight: 600; font-size: 1.25rem; color: var(--text); margin: 0; }
  .hnf-lp__item-benefit { font-family: var(--font-body-family); font-size: 1.25rem; line-height: 1.5; color: var(--muted); margin: 0; }
  .hnf-lp__item-value { display: flex; align-items: baseline; gap: 0.8rem; margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--soft-gray); }
  .hnf-lp__item-value b { font-family: var(--font-body-family); font-weight: 700; font-size: 1.5rem; color: var(--text); }
  .hnf-lp__item-value span { font-family: var(--font-body-family); font-size: 1.1rem; color: var(--muted); }
  @media screen and (max-width: 989px) { .hnf-lp__items { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 640px) { .hnf-lp__items { grid-template-columns: 1fr; } }

  /* WHY IT WORKS */
  .hnf-lp__pillars { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 3.6rem; }
  .hnf-lp__pillar { text-align: center; }
  .hnf-lp__pillar-icon { width: 5.6rem; height: 5.6rem; margin: 0 auto 1.4rem; border-radius: 50%; border: 2px solid var(--accent); color: var(--accent); display: flex; align-items: center; justify-content: center; }
  .hnf-lp__pillar-icon svg { width: 2.6rem; height: 2.6rem; }
  .hnf-lp__pillar h3 { font-family: var(--font-body-family); font-weight: 700; font-size: 1.4rem; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 0.7rem; color: var(--text); }
  .hnf-lp__pillar p { font-family: var(--font-body-family); font-size: 1.2rem; line-height: 1.5; color: var(--muted); margin: 0; }
  @media screen and (max-width: 749px) { .hnf-lp__pillars { grid-template-columns: repeat(2, 1fr); } }

  /* BEST SELLERS (quick add) */
  .hnf-lp__cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-top: 3.6rem; }
  .hnf-lp__card { background: var(--paper); border: 1px solid var(--soft-gray); display: flex; flex-direction: column; }
  .hnf-lp__card-media { aspect-ratio: 1/1; background: linear-gradient(180deg, #fff 0%, var(--warm-bg) 100%); display: flex; align-items: center; justify-content: center; overflow: hidden; }
  .hnf-lp__card-media img { width: 78%; height: 78%; object-fit: contain; }
  .hnf-lp__card-body { padding: 1.8rem; display: flex; flex-direction: column; gap: 0.8rem; flex: 1; }
  .hnf-lp__card-name { font-family: var(--font-heading-family); font-weight: 400; text-transform: uppercase; font-size: 1.7rem; line-height: 1.05; margin: 0; color: var(--text); }
  .hnf-lp__card-price { font-family: var(--font-body-family); font-weight: 700; font-size: 1.5rem; color: var(--text); margin: 0 0 0.4rem; }
  .hnf-lp__quickadd {
    margin-top: auto; display: inline-flex; align-items: center; justify-content: center; gap: 0.6rem;
    min-height: 4.6rem; font-family: var(--font-body-family); font-weight: 700; font-size: 1.15rem;
    letter-spacing: 0.04em; text-transform: uppercase; color: #fff; background: var(--accent); border: none;
    cursor: pointer; border-radius: 2px; transition: background-color .12s ease;
  }
  .hnf-lp__quickadd:hover { background: var(--accent-hover); }
  .hnf-lp__quickadd[data-state="loading"] { opacity: 0.7; pointer-events: none; }
  .hnf-lp__quickadd[data-state="added"] { background: #1a7a3c; }
  @media screen and (max-width: 989px) { .hnf-lp__cards { grid-template-columns: repeat(2, 1fr); } }
  @media screen and (max-width: 520px) { .hnf-lp__cards { grid-template-columns: 1fr; } }

  /* PRODUCT BENEFITS */
  .hnf-lp__benefits { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2.4rem; margin-top: 3.6rem; }
  .hnf-lp__benefit { text-align: left; }
  .hnf-lp__benefit h3 { font-family: var(--font-body-family); font-weight: 600; font-size: 1.3rem; letter-spacing: 0.03em; text-transform: uppercase; margin: 0 0 0.6rem; color: #fff; }
  .hnf-lp__benefit p { font-family: var(--font-body-family); font-size: 1.2rem; line-height: 1.5; color: #b8b8b8; margin: 0; }
  @media screen and (max-width: 749px) { .hnf-lp__benefits { grid-template-columns: repeat(2, 1fr); } }

  /* LIFESTYLE — given real vertical spacing + a background color so it never
     visually fuses with the black Product Benefits section above it; fixed
     aspect-ratio (not max-height crop) so the new wide-composed photo never
     gets zoomed into an awkward random crop. */
  .hnf-lp__lifestyle-wrap { background: var(--paper); padding: clamp(3rem, 6vw, 5rem) 0; }
  .hnf-lp__lifestyle-media { max-width: 130rem; margin: 0 auto; padding: 0 2rem; }
  .hnf-lp__lifestyle-media img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; object-position: center 35%; display: block; }

  /* GUARANTEE */
  .hnf-lp__guarantee { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2.4rem; margin-top: 3.6rem; }
  .hnf-lp__guarantee-card { text-align: center; padding: 2.4rem 1.8rem; background: var(--paper); border: 1px solid var(--soft-gray); }
  .hnf-lp__guarantee-card svg { width: 3.6rem; height: 3.6rem; color: var(--accent); margin: 0 auto 1.4rem; display: block; }
  .hnf-lp__guarantee-card h3 { font-family: var(--font-body-family); font-weight: 700; font-size: 1.5rem; margin: 0 0 0.8rem; color: var(--text); }
  .hnf-lp__guarantee-card p { font-family: var(--font-body-family); font-size: 1.25rem; line-height: 1.5; color: var(--muted); margin: 0; }
  @media screen and (max-width: 749px) { .hnf-lp__guarantee { grid-template-columns: 1fr; } }

  /* EDUCATION */
  .hnf-lp__guides { display: grid; grid-template-columns: repeat(2, 1fr); gap: 2rem; margin-top: 3.6rem; }
  .hnf-lp__guide { display: block; text-decoration: none; color: var(--text); border: 1px solid var(--soft-gray); }
  .hnf-lp__guide-media { aspect-ratio: 16/10; overflow: hidden; background: var(--paper-dim); }
  .hnf-lp__guide-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hnf-lp__guide-body { padding: 1.8rem 2rem 2.2rem; }
  .hnf-lp__guide-label { font-family: var(--font-body-family); font-weight: 600; font-size: 1.1rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 0.6rem; }
  .hnf-lp__guide-title { font-family: var(--font-heading-family); font-weight: 400; text-transform: uppercase; font-size: 1.9rem; margin: 0 0 0.7rem; }
  .hnf-lp__guide-desc { font-family: var(--font-body-family); font-size: 1.25rem; line-height: 1.5; color: var(--muted); margin: 0; }
  @media screen and (max-width: 749px) { .hnf-lp__guides { grid-template-columns: 1fr; } }

  /* FAQ */
  .hnf-lp__faq { max-width: 78rem; margin: 3.6rem auto 0; }
  .hnf-lp__faq-item { border-bottom: 1px solid var(--soft-gray); }
  .hnf-lp__faq-item summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.6rem; cursor: pointer;
    padding: 2rem 0; font-family: var(--font-body-family); font-weight: 700; font-size: 1.5rem; color: var(--text); list-style: none;
  }
  .hnf-lp__faq-item summary::-webkit-details-marker { display: none; }
  .hnf-lp__faq-item summary::after { content: '+'; font-size: 2.2rem; color: var(--accent); font-weight: 400; flex: none; transition: transform .15s ease; }
  .hnf-lp__faq-item[open] summary::after { transform: rotate(45deg); }
  .hnf-lp__faq-item p { font-family: var(--font-body-family); font-size: 1.3rem; line-height: 1.6; color: var(--muted); margin: 0 0 2rem; max-width: 68ch; }

  /* FINAL OFFER */
  .hnf-lp__final { text-align: center; }
  .hnf-lp__final-price { display: flex; align-items: baseline; justify-content: center; gap: 1.2rem; margin: 2.2rem 0 0.6rem; flex-wrap: wrap; }
  .hnf-lp__final-price b { font-family: var(--font-body-family); font-weight: 700; font-size: 4rem; color: #fff; }
  .hnf-lp__final-price span { font-family: var(--font-body-family); font-size: 1.4rem; color: #b8b8b8; }
  .hnf-lp__final-savings { font-family: var(--font-body-family); font-weight: 800; font-size: 1.7rem; text-transform: uppercase; letter-spacing: 0.01em; color: var(--accent); margin: 0 0 2.6rem; }
  .hnf-lp__final-ctas { display: flex; justify-content: center; gap: 1.4rem; flex-wrap: wrap; }
{%- endstyle -%}

