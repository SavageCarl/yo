<script>
  (function () {
    /* This theme's cart_type is "notification", so the live cart UI element
       is <cart-notification>, not <cart-drawer> — document.querySelector('cart-drawer')
       always returns null here, and even if it existed, renderContents() needs
       the add response's `.sections` shape, not a plain /cart.js payload. Mirror
       Dawn's own product-form.js: look up whichever cart UI element is present,
       ask it which sections it needs, and request those on the add call. */
    var cartUi = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
    var buttons = document.querySelectorAll('.hnf-lp__quickadd');
    buttons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (btn.getAttribute('data-state') === 'loading') return;
        var variantId = btn.getAttribute('data-variant-id');
        btn.setAttribute('data-state', 'loading');
        var originalText = btn.textContent;
        btn.textContent = 'Adding…';
        var payload = { items: [{ id: parseInt(variantId, 10), quantity: 1 }] };
        if (cartUi && typeof cartUi.getSectionsToRender === 'function') {
          payload.sections = cartUi.getSectionsToRender().map(function (s) { return s.id; });
          payload.sections_url = window.location.pathname;
        }
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function (res) {
            if (!res.ok) throw new Error('Add to cart failed');
            return res.json();
          })
          .then(function (item) {
            /* An `items` add answers { items: [...] }; cart-notification needs a top-level key. */
            if (item && !item.key && item.items && item.items[0]) item.key = item.items[0].key;
            btn.setAttribute('data-state', 'added');
            btn.textContent = 'Added ✓';
            if (item.sections) {
              var bubble = document.getElementById('cart-icon-bubble');
              if (bubble && item.sections['cart-icon-bubble']) {
                var parsed = new DOMParser().parseFromString(item.sections['cart-icon-bubble'], 'text/html');
                var section = parsed.querySelector('.shopify-section');
                if (section) bubble.innerHTML = section.innerHTML;
              }
              if (cartUi && typeof cartUi.renderContents === 'function') {
                try { cartUi.renderContents(item); } catch (renderError) { /* item is already in the cart */ }
              }
            }
            document.dispatchEvent(new CustomEvent('cart:refresh'));
            setTimeout(function () {
              btn.setAttribute('data-state', 'idle');
              btn.textContent = originalText;
            }, 2200);
          })
          .catch(function () {
            btn.setAttribute('data-state', 'idle');
            btn.textContent = originalText;
            /* Never fall back to a /cart/{id}:1 permalink: it skips the cart and opens
               a checkout holding only this item. */
            window.location.href = '/cart';
          });
      });
    });
  })();
</script>

